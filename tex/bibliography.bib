@inproceedings{pereiraGeneratingMicroserviceArchitectures2025,
	title = {Toward Generating Microservice Architectures from Textual Requirements with Large Language Models},
	rights = {Copyright (c)},
	issn = {0000-0000},
	url = {https://sol.sbc.org.br/index.php/sbcars/article/view/36976},
	doi = {10.5753/sbcars.2025.14591},
	abstract = {Large Language Models ({LLMs}) have demonstrated strong performance in natural language understanding and generation, opening new possibilities for automating software engineering tasks. This study evaluates whether the {GPT}-4 O3 model can generate microservice-oriented architectures directly from textual requirements. We applied two prompting strategies—zero-shot ({ZS}) and few-shot ({FS})—to two real-world-inspired systems (Bookstore and {PetClinic}) and compared the outputs against their reference architectures. In {ZS}, {GPT}-4 identified 11 out of 14 expected services (precision, recall, and F1 ≈ 0.79) and recovered 33 out of 38 interservice links (precision ≈ 0.50, recall ≈ 0.87, F1 ≈ 0.64), but also introduced 34 unsupported links. Under {FS}, it matched all 14 services (precision ≈ 0.93, recall = 1.00, F1 ≈ 0.97) and recovered every expected link, while reducing spurious connections to 12 (precision ≈ 0.76, recall = 1.00, F1 ≈ 0.86). A mixed-methods evaluation by four senior architects confirmed these trends. The {FS} received the best expert scores (avg. correctness ≈ 4.6/5, plausibility ≈ 4.5/5) because they balanced full requirement coverage with sound modularity, whereas the {ZS} versions, though complete, were downgraded for dense bidirectional coupling (plausibility ≈ 2/5). The reference architecture sat in between, structurally tidy but functionally sparse. Overall, the study shows that supplying even a single exemplar can transform {GPT}-4 from a rough sketch generator into a credible assistant for microservice decomposition, giving architects a rapid and reliable starting point for design.},
	eventtitle = {Simpósio Brasileiro de Componentes, Arquiteturas e Reutilização de Software ({SBCARS})},
	pages = {79--89},
	booktitle = {Simpósio Brasileiro de Componentes, Arquiteturas e Reutilização de Software ({SBCARS})},
	publisher = {{SBC}},
	author = {Pereira, Jose Renan A. and Albuquerque, Danyllo and Perkusich, Mirko and Rodríguez, Guillermo and Díaz-Pace, Jorge Andrés and Gorgônio, Kyller and Perkusich, Angelo},
	urldate = {2026-03-25},
	date = {2025-09-22},
	langid = {english},
	file = {Full Text PDF:/home/tomek/zotero/storage/UKNLARFJ/Pereira et al. - 2025 - Toward Generating Microservice Architectures from Textual Requirements with Large Language Models.pdf:application/pdf;replication package zip:/home/tomek/zotero/storage/WPHLBUNC/29974345.zip:application/pdf},
}


@inproceedings{soliman_large_2025,
	title = {Do Large Language Models Contain Software Architectural Knowledge? : An Exploratory Case Study with {GPT}},
	issn = {2835-7043},
	url = {https://ieeexplore.ieee.org/document/10978937},
	doi = {10.1109/ICSA65012.2025.00012},
	shorttitle = {Do Large Language Models Contain Software Architectural Knowledge?},
	abstract = {Architectural knowledge ({AK}) of existing systems is essential for software engineers to make design decisions. Recently, Large Language Models ({LLMs}) trained on large-scale datasets, including software repositories, have shown promise in embedding knowledge and answering questions. However, {LLMs} have not been evaluated for their abilities to answer questions about {AK}, leaving doubts about their accuracy. This paper assesses {GPT}, a leading {LLM}, by evaluating its responses’ accuracy, quality, and trustworthiness on the {AK} of the large-scale open-source system {HDFS}. We conducted an exploratory case study with 14 software engineers who posed questions to {GPT} and compared its responses to a predefined ground truth. The engineers rated {GPT}’s answers with moderate quality and trustworthiness. Our findings on {GPT}’s accuracy indicates moderate recall but lower precision, especially in identifying quality attribute solutions and design rationales. These results suggest that while {GPT} and similar models can provide initial insights into {AK}, expert validation remains necessary for reliability. This study underscores {LLMs}’ potential and limitations to discover software {AK}.},
	eventtitle = {2025 {IEEE} 22nd International Conference on Software Architecture ({ICSA})},
	pages = {13--24},
	booktitle = {2025 {IEEE} 22nd International Conference on Software Architecture ({ICSA})},
	author = {Soliman, Mohamed and Keim, Jan},
	urldate = {2026-03-26},
	date = {2025-03},
	note = {{ISSN}: 2835-7043},
	keywords = {Accuracy, Architecture design decisions, Architecture knowledge, Computer architecture, {GPT}, Knowledge engineering, Large language models, Large Language Models, Software, Software architecture, Software reliability},
	file = {PDF:/home/tomek/zotero/storage/TAA6BWMV/Soliman and Keim - 2025 - Do Large Language Models Contain Software Architectural Knowledge  An Exploratory Case Study with.pdf:application/pdf;Snapshot:/home/tomek/zotero/storage/H3KN9DQK/10978937.html:text/html},
}

