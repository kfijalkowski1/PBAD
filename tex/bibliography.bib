@misc{coulin_software_2019,
	title = {Software Architecture Metrics: a literature review},
	url = {http://arxiv.org/abs/1901.09050},
	doi = {10.48550/arXiv.1901.09050},
	shorttitle = {Software Architecture Metrics},
	abstract = {In Software Engineering, early detection of architectural issues is key. It helps mitigate the risk of poor performance, and lowers the cost of repairing these issues. Metrics give a quick overview of the project which helps designers with the detection of flaws or degradation in their architecture. Even though studies unveiled architectural metrics more than 25 years ago, they have not yet been embraced by the industry nor the open source community. In this study, we aim at conducting a review of existing metrics focused on the software architecture for evaluating quality, early in the design flow and throughout the project's lifetime. We also give guidelines of their usage and study their relevance in different contexts.},
	number = {{arXiv}:1901.09050},
	publisher = {{arXiv}},
	author = {Coulin, Théo and Detante, Maxence and Mouchère, William and Petrillo, Fabio},
	urldate = {2026-03-22},
	date = {2019-01-25},
	eprinttype = {arxiv},
	eprint = {1901.09050 [cs]},
	keywords = {Computer Science - Software Engineering},
	file = {Preprint PDF:/home/tomek/zotero/storage/4FM4L42T/Coulin et al. - 2019 - Software Architecture Metrics a literature review.pdf:application/pdf;Snapshot:/home/tomek/zotero/storage/BKVFKI7A/1901.html:text/html},
}


@misc{adnan_archbench_2026,
	title = {{ArchBench}: Benchmarking Generative-{AI} for Software Architecture Tasks},
	url = {http://arxiv.org/abs/2603.17833},
	doi = {10.48550/arXiv.2603.17833},
	shorttitle = {{ArchBench}},
	abstract = {Benchmarks for large language models ({LLMs}) have progressed from snippet-level function generation to repository-level issue resolution, yet they overwhelmingly target implementation correctness. Software architecture tasks remain under-specified and difficult to compare across models, despite their central role in maintaining and evolving complex systems. We present {ArchBench}, the first unified platform for benchmarking {LLM} capabilities on software architecture tasks. {ArchBench} provides a command-line tool with a standardized pipeline for dataset download, inference with trajectory logging, and automated evaluation, alongside a public web interface with an interactive leaderboard. The platform is built around a plugin architecture where each task is a self-contained module, making it straightforward for the community to contribute new architectural tasks and evaluation results. We use the term {LLMs} broadly to encompass generative {AI} ({GenAI}) solutions for software engineering, including both standalone models and {LLM}-based coding agents equipped with tools. Both the {CLI} tool and the web platform are openly available to support reproducible research and community-driven growth of architectural benchmarking.},
	number = {{arXiv}:2603.17833},
	publisher = {{arXiv}},
	author = {Adnan, Bassam and Gupta, Aviral and Akshathala, Sreemaee and Vaidhyanathan, Karthik},
	urldate = {2026-03-22},
	date = {2026-03-18},
	eprinttype = {arxiv},
	eprint = {2603.17833 [cs]},
	note = {version: 1},
	keywords = {Computer Science - Software Engineering},
	file = {Preprint PDF:/home/tomek/zotero/storage/U3H9RNHX/Adnan et al. - 2026 - ArchBench Benchmarking Generative-AI for Software Architecture Tasks.pdf:application/pdf;Snapshot:/home/tomek/zotero/storage/MKM3I6EY/2603.html:text/html},
}
