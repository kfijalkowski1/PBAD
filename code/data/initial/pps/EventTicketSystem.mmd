graph TD

    %% Clients
    ClientWeb[Web Application]
    ClientMobile[Mobile Application]

    %% Edge Layer
    APIGW[API Gateway]
    BFF[BFF Layer]

    %% Core Services
    Auth[Authentication Service]
    Event[Event Service]
    Search[Search Service]
    Inventory[Inventory Service]
    Order[Order Service]
    Payment[Payment Service]
    Ticket[Ticket Service]
    Notification[Notification Service]

    %% Platform Services
    Config[Config Service]
    FeatureFlag[Feature Flag Service]
    Observability[Monitoring & Logging]

    %% Data Stores
    AuthDB[(User Database)]
    EventDB[(Event Database)]
    InventoryDB[(Inventory Database)]
    OrderDB[(Order Database)]
    TicketDB[(Ticket Database)]
    SearchIndex[(Search Index)]

    %% Event Streaming
    EventBus[(Event Bus / Stream)]

    %% External Systems
    PaymentExt[Payment Gateway]
    EmailExt[Email Service]
    IdP[Identity Provider]

    %% Flow
    ClientWeb --> APIGW
    ClientMobile --> APIGW
    APIGW --> BFF

    BFF --> Auth
    BFF --> Event
    BFF --> Search
    BFF --> Order

    Auth --> AuthDB
    Auth --> IdP

    Event --> EventDB
    Search --> SearchIndex

    Order --> Inventory
    Order --> Payment

    Inventory --> InventoryDB
    Order --> OrderDB
    Ticket --> TicketDB

    %% Event-driven backbone
    Order --> EventBus
    Inventory --> EventBus
    Payment --> EventBus

    EventBus --> Ticket
    EventBus --> Notification
    EventBus --> Search

    %% External integrations
    Payment --> PaymentExt
    Notification --> EmailExt

    %% Platform services
    Auth --> Config
    Event --> Config
    Order --> Config

    Auth --> FeatureFlag
    Event --> FeatureFlag

    Auth --> Observability
    Order --> Observability
    Inventory --> Observability